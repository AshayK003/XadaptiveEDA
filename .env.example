# LLM Provider Configuration (optional — local Ollama works without any keys)
# Get free keys at: https://openrouter.ai/keys or https://console.groq.com/keys

# OpenRouter (free tier available)
# OPENROUTER_API_KEY=sk-or-v1-...

# Groq (free tier available)
# GROQ_API_KEY=gsk_...

# Custom API (OpenAI-compatible endpoint)
# CUSTOM_API_KEY=...
